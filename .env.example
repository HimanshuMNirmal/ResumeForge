# ── Required ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://resume:CHANGE_ME@localhost:5432/resume_builder

# JWT signing key — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_min_32_chars_random_string

# AES-256-GCM key for encrypting user API keys in DB
# Must be exactly 32 bytes. Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# Docker DB password
DB_PASSWORD=CHANGE_ME

# ── S3 / Storage ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=resume-builder-prod
S3_REGION=us-east-1
# For Cloudflare R2 or MinIO, set this:
# S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com

# ── Platform LLM fallback (optional) ──────────────────────────────────────────
# Users without their own key will use this for free (rate-limited)
PLATFORM_ANTHROPIC_KEY=
PLATFORM_OPENAI_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Dev settings ───────────────────────────────────────────────────────────────
DEBUG=true

# ── Production only (set on EC2) ──────────────────────────────────────────────
# FRONTEND_DOMAIN=resumeforge.com
# BACKEND_IMAGE=123456789.dkr.ecr.us-east-1.amazonaws.com/resume-builder-backend:sha
